"customer" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#F4F4F4"><tr><td bgcolor="#111111" colspan="3"><font color="white"><b>customer</b></font></td></tr><tr><td align="left" port="customer_id"><b>customer_id</b></td><td align="left"><font color="#555555">int</font></td><td align="left">PK</td></tr><tr><td align="left" port="full_name">full_name</td><td align="left"><font color="#555555">varchar(100)</font></td><td align="left"></td></tr><tr><td align="left" port="phone">phone</td><td align="left"><font color="#555555">char(10)</font></td><td align="left">U</td></tr><tr><td align="left" port="email">email</td><td align="left"><font color="#555555">varchar(100)</font></td><td align="left">U</td></tr><tr><td align="left" port="dob">dob</td><td align="left"><font color="#555555">date</font></td><td align="left"></td></tr><tr><td align="left" port="city">city</td><td align="left"><font color="#555555">varchar(50)</font></td><td align="left"></td></tr><tr><td align="left" port="kyc_status">kyc_status</td><td align="left"><font color="#555555">varchar(10)</font></td><td align="left"></td></tr><tr><td align="left" port="referred_by">referred_by</td><td align="left"><font color="#555555">int</font></td><td align="left">FK</td></tr><tr><td align="left" port="created_at">created_at</td><td align="left"><font color="#555555">datetime</font></td><td align="left"></td></tr></table>>];
