digraph schema {
rankdir=LR; nodesep=0.35; ranksep=1.0; bgcolor="white"; pad=0.3;
node [shape=plaintext, fontname="Helvetica", fontsize=10];
edge [color="#555555", arrowsize=0.7, fontname="Helvetica", fontsize=8];
label="UPIShield - Relational Schema (PK = primary key, FK = foreign key, U = unique)"; labelloc=t; fontsize=14;
"audit_log" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#F4F4F4"><tr><td bgcolor="#111111" colspan="3"><font color="white"><b>audit_log</b></font></td></tr><tr><td align="left" port="log_id"><b>log_id</b></td><td align="left"><font color="#555555">bigint</font></td><td align="left">PK</td></tr><tr><td align="left" port="table_name">table_name</td><td align="left"><font color="#555555">varchar(30)</font></td><td align="left"></td></tr><tr><td align="left" port="operation">operation</td><td align="left"><font color="#555555">varchar(6)</font></td><td align="left"></td></tr><tr><td align="left" port="record_id">record_id</td><td align="left"><font color="#555555">varchar(50)</font></td><td align="left"></td></tr><tr><td align="left" port="old_value">old_value</td><td align="left"><font color="#555555">text</font></td><td align="left"></td></tr><tr><td align="left" port="new_value">new_value</td><td align="left"><font color="#555555">text</font></td><td align="left"></td></tr><tr><td align="left" port="changed_by">changed_by</td><td align="left"><font color="#555555">varchar(100)</font></td><td align="left"></td></tr><tr><td align="left" port="changed_at">changed_at</td><td align="left"><font color="#555555">datetime(3)</font></td><td align="left"></td></tr></table>>];
"bank" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#F4F4F4"><tr><td bgcolor="#111111" colspan="3"><font color="white"><b>bank</b></font></td></tr><tr><td align="left" port="bank_code"><b>bank_code</b></td><td align="left"><font color="#555555">char(4)</font></td><td align="left">PK</td></tr><tr><td align="left" port="bank_name">bank_name</td><td align="left"><font color="#555555">varchar(100)</font></td><td align="left">U</td></tr><tr><td align="left" port="bank_type">bank_type</td><td align="left"><font color="#555555">varchar(12)</font></td><td align="left"></td></tr><tr><td align="left" port="hq_city">hq_city</td><td align="left"><font color="#555555">varchar(50)</font></td><td align="left"></td></tr><tr><td align="left" port="established_year">established_year</td><td align="left"><font color="#555555">smallint</font></td><td align="left"></td></tr></table>>];
"bank_account" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#F4F4F4"><tr><td bgcolor="#111111" colspan="3"><font color="white"><b>bank_account</b></font></td></tr><tr><td align="left" port="account_id"><b>account_id</b></td><td align="left"><font color="#555555">int</font></td><td align="left">PK</td></tr><tr><td align="left" port="customer_id">customer_id</td><td align="left"><font color="#555555">int</font></td><td align="left">FK</td></tr><tr><td align="left" port="ifsc">ifsc</td><td align="left"><font color="#555555">char(11)</font></td><td align="left">FK</td></tr><tr><td align="left" port="account_no_enc">account_no_enc</td><td align="left"><font color="#555555">varbinary(64)</font></td><td align="left">U</td></tr><tr><td align="left" port="account_no_last4">account_no_last4</td><td align="left"><font color="#555555">char(4)</font></td><td align="left"></td></tr><tr><td align="left" port="account_type">account_type</td><td align="left"><font color="#555555">varchar(10)</font></td><td align="left"></td></tr><tr><td align="left" port="balance">balance</td><td align="left"><font color="#555555">decimal(14,2)</font></td><td align="left"></td></tr><tr><td align="left" port="status">status</td><td align="left"><font color="#555555">varchar(10)</font></td><td align="left"></td></tr><tr><td align="left" port="opened_on">opened_on</td><td align="left"><font color="#555555">date</font></td><td align="left"></td></tr></table>>];
"branch" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#F4F4F4"><tr><td bgcolor="#111111" colspan="3"><font color="white"><b>branch</b></font></td></tr><tr><td align="left" port="ifsc"><b>ifsc</b></td><td align="left"><font color="#555555">char(11)</font></td><td align="left">PK</td></tr><tr><td align="left" port="bank_code">bank_code</td><td align="left"><font color="#555555">char(4)</font></td><td align="left">FK</td></tr><tr><td align="left" port="branch_name">branch_name</td><td align="left"><font color="#555555">varchar(100)</font></td><td align="left"></td></tr><tr><td align="left" port="city">city</td><td align="left"><font color="#555555">varchar(50)</font></td><td align="left"></td></tr><tr><td align="left" port="state">state</td><td align="left"><font color="#555555">varchar(50)</font></td><td align="left"></td></tr></table>>];
