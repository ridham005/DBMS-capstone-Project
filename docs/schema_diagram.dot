"dispute" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#F4F4F4"><tr><td bgcolor="#111111" colspan="3"><font color="white"><b>dispute</b></font></td></tr><tr><td align="left" port="txn_id"><b>txn_id</b></td><td align="left"><font color="#555555">bigint</font></td><td align="left">PK FK</td></tr><tr><td align="left" port="dispute_no"><b>dispute_no</b></td><td align="left"><font color="#555555">tinyint unsigned</font></td><td align="left">PK</td></tr><tr><td align="left" port="raised_by">raised_by</td><td align="left"><font color="#555555">int</font></td><td align="left">FK</td></tr><tr><td align="left" port="reason">reason</td><td align="left"><font color="#555555">varchar(20)</font></td><td align="left"></td></tr><tr><td align="left" port="description">description</td><td align="left"><font color="#555555">varchar(255)</font></td><td align="left"></td></tr><tr><td align="left" port="status">status</td><td align="left"><font color="#555555">varchar(12)</font></td><td align="left"></td></tr><tr><td align="left" port="raised_on">raised_on</td><td align="left"><font color="#555555">datetime</font></td><td align="left"></td></tr><tr><td align="left" port="resolved_on">resolved_on</td><td align="left"><font color="#555555">datetime</font></td><td align="left"></td></tr></table>>];
