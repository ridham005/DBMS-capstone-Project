graph ERD {
layout=neato; overlap=false; sep="+14"; splines=true; outputorder=edgesfirst;
bgcolor="white"; pad=0.4; fontname="Helvetica";
node [fontname="Helvetica", fontsize=11, color="#111111", fontcolor="#111111"];
edge [color="#333333", fontname="Helvetica", fontsize=11, len=1.4];
label="UPIShield - ER Diagram (Chen notation)   |   double line = total participation, double box = weak entity, double diamond = identifying relationship, dashed = derived, underline = key, dashed underline = partial key, (d) = disjoint specialization"; labelloc=t; fontsize=13;
"BANK" [shape=box, style="filled", fillcolor="#E6E6E6", fontsize=12, peripheries=1, label=<<b>BANK</b>>];
"BANK.bank_code" [shape=ellipse, fontsize=9, height=0.3, label=<<u>bank_code</u>>];
"BANK" -- "BANK.bank_code" [len=0.9];
"BANK.bank_name" [shape=ellipse, fontsize=9, height=0.3, label="bank_name"];
"BANK" -- "BANK.bank_name" [len=0.9];
"BANK.bank_type" [shape=ellipse, fontsize=9, height=0.3, label="bank_type"];
